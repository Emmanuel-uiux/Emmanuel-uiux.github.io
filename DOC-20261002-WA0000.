<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Emmanuel Olabiyi | Web Designer & Developer</title>

  <meta name="description" content="Emmanuel Olabiyi is a web designer and developer creating modern, high-converting websites for businesses and real estate professionals.">

  <style>
    /* =========================
       RESET
    ========================== */

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #080808;
      color: #ffffff;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }


    /* =========================
       VARIABLES
    ========================== */

    :root {
      --gold: #d6b36a;
      --gold-light: #f0d99b;
      --dark: #080808;
      --dark-2: #111111;
      --dark-3: #171717;
      --gray: #a5a5a5;
      --white: #ffffff;
      --border: rgba(255,255,255,0.1);
    }


    /* =========================
       NAVIGATION
    ========================== */

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(8,8,8,0.85);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid var(--border);
    }

    nav {
      max-width: 1200px;
      margin: auto;
      height: 80px;
      padding: 0 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .logo span {
      color: var(--gold);
    }

    .nav-links {
      display: flex;
      gap: 35px;
      list-style: none;
    }

    .nav-links a {
      color: #ddd;
      font-size: 14px;
      transition: 0.3s;
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .menu-btn {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 28px;
      cursor: pointer;
    }


    /* =========================
       HERO
    ========================== */

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      padding: 140px 25px 80px;
      background:
        radial-gradient(circle at 80% 20%, rgba(214,179,106,0.15), transparent 30%),
        radial-gradient(circle at 10% 80%, rgba(214,179,106,0.08), transparent 30%),
        #080808;
    }

    .hero-container {
      max-width: 1200px;
      width: 100%;
      margin: auto;
    }

    .hero-small {
      color: var(--gold);
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 4px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: clamp(45px, 8vw, 90px);
      line-height: 1;
      max-width: 900px;
      margin-bottom: 30px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero-description {
      max-width: 650px;
      color: var(--gray);
      font-size: 18px;
      margin-bottom: 40px;
    }

    .buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 15px 28px;
      border-radius: 4px;
      font-weight: 600;
      transition: 0.3s;
      cursor: pointer;
    }

    .btn-primary {
      background: var(--gold);
      color: #080808;
    }

    .btn-primary:hover {
      background: var(--gold-light);
      transform: translateY(-3px);
    }

    .btn-outline {
      border: 1px solid var(--border);
      color: white;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      color: var(--gold);
    }


    /* =========================
       SECTIONS
    ========================== */

    section {
      padding: 110px 25px;
    }

    .container {
      max-width: 1200px;
      margin: auto;
    }

    .section-label {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 13px;
      margin-bottom: 15px;
    }

    .section-title {
      font-size: clamp(35px, 5vw, 55px);
      margin-bottom: 20px;
    }

    .section-description {
      color: var(--gray);
      max-width: 650px;
      margin-bottom: 50px;
    }


    /* =========================
       ABOUT
    ========================== */

    .about {
      background: var(--dark-2);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
      align-items: center;
    }

    .about-text p {
      color: var(--gray);
      margin-bottom: 20px;
      font-size: 17px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .stat {
      background: var(--dark-3);
      border: 1px solid var(--border);
      padding: 30px;
      border-radius: 8px;
    }

    .stat h3 {
      color: var(--gold);
      font-size: 40px;
      margin-bottom: 5px;
    }

    .stat p {
      color: var(--gray);
      font-size: 14px;
    }


    /* =========================
       SERVICES
    ========================== */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .service-card {
      background: var(--dark-2);
      border: 1px solid var(--border);
      padding: 40px 30px;
      border-radius: 8px;
      transition: 0.4s;
    }

    .service-card:hover {
      transform: translateY(-8px);
      border-color: rgba(214,179,106,0.5);
    }

    .service-number {
      color: var(--gold);
      font-size: 14px;
      margin-bottom: 25px;
    }

    .service-card h3 {
      font-size: 22px;
      margin-bottom: 15px;
    }

    .service-card p {
      color: var(--gray);
      font-size: 15px;
    }


    /* =========================
       PORTFOLIO
    ========================== */

    .portfolio {
      background: var(--dark-2);
    }

    .projects {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .project {
      background: var(--dark-3);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      transition: 0.4s;
    }

    .project:hover {
      transform: translateY(-8px);
    }

    .project-image {
      height: 280px;
      background:
        linear-gradient(135deg, #202020, #0b0b0b);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 18px;
      position: relative;
    }

    .project-image::before {
      content: "WEBSITE PREVIEW";
      font-size: 12px;
      letter-spacing: 3px;
      opacity: 0.5;
    }

    .project-info {
      padding: 25px;
    }

    .project-info h3 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .project-info p {
      color: var(--gray);
      font-size: 14px;
      margin-bottom: 15px;
    }

    .project-link {
      color: var(--gold);
      font-size: 14px;
      font-weight: 600;
    }


    /* =========================
       SKILLS
    ========================== */

    .skills {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .skill {
      margin-bottom: 25px;
    }

    .skill-top {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 14px;
    }

    .skill-top span:last-child {
      color: var(--gold);
    }

    .skill-bar {
      height: 5px;
      background: #222;
      border-radius: 10px;
      overflow: hidden;
    }

    .skill-progress {
      height: 100%;
      background: var(--gold);
    }


    /* =========================
       PROCESS
    ========================== */

    .process {
      background: var(--dark-2);
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .process-item {
      border-top: 1px solid var(--border);
      padding-top: 25px;
    }

    .process-item span {
      color: var(--gold);
      font-size: 13px;
    }

    .process-item h3 {
      margin: 15px 0 10px;
    }

    .process-item p {
      color: var(--gray);
      font-size: 14px;
    }


    /* =========================
       CONTACT
    ========================== */

    .contact {
      text-align: center;
    }

    .contact-box {
      max-width: 800px;
      margin: auto;
    }

    .contact-box h2 {
      font-size: clamp(40px, 6vw, 70px);
      margin-bottom: 20px;
    }

    .contact-box p {
      color: var(--gray);
      font-size: 17px;
      margin-bottom: 35px;
    }

    .contact-details {
      display: flex;
      justify-content: center;
      gap: 30px;
      flex-wrap: wrap;
      margin-top: 35px;
      color: var(--gray);
    }

    .contact-details a:hover {
      color: var(--gold);
    }


    /* =========================
       FOOTER
    ========================== */

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 25px;
      color: #777;
      font-size: 13px;
    }

    .footer-inner {
      max-width: 1200px;
      margin: auto;
      display: flex;
      justify-content: space-between;
      gap: 20px;
    }


    /* =========================
       ANIMATION
    ========================== */

    .fade-up {
      animation: fadeUp 1s ease forwards;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }


    /* =========================
       MOBILE
    ========================== */

    @media (max-width: 800px) {

      .nav-links {
        position: absolute;
        top: 80px;
        left: 0;
        width: 100%;
        background: #0b0b0b;
        flex-direction: column;
        padding: 25px;
        gap: 20px;
        display: none;
        border-bottom: 1px solid var(--border);
      }

      .nav-links.active {
        display: flex;
      }

      .menu-btn {
        display: block;
      }

      .about-grid,
      .skills {
        grid-template-columns: 1fr;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .projects {
        grid-template-columns: 1fr;
      }

      .process-grid {
        grid-template-columns: 1fr 1fr;
      }

      .hero {
        padding-top: 130px;
      }
    }


    @media (max-width: 500px) {

      section {
        padding: 80px 20px;
      }

      nav {
        padding: 0 20px;
      }

      .hero h1 {
        font-size: 48px;
      }

      .hero-description {
        font-size: 16px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .process-grid {
        grid-template-columns: 1fr;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

    }

  </style>
</head>


